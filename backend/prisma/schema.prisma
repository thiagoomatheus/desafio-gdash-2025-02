generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
}

model WeatherLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  latitude    Float
  longitude   Float
  collectedAt DateTime @default(now())

  city                String?  @default("Paranapanema")
  temperature         Float
  condition           Int
  humidity            Int
  apparentTemperature Float
  precipitation       Float
  isDay               Boolean
  windSpeed           Float
  solarRadiation      Float?   @default(0)

  insights            Json
  fullData            Json 

  createdAt DateTime @default(now())

  @@map("weather_logs")
}